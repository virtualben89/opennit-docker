# Kopieren nach .env und anpassen:  cp .env.example .env

# Image aus der GitHub Container Registry:
#   :1      folgt allen 1.x-Versionen     :1.2   nur Bugfixes von 1.2
#   :1.2.2  fest (Update nur durch Ändern dieses Werts)
# Zeile auskommentieren, um lokal zu bauen (docker compose up -d --build).
OPENNIT_IMAGE=ghcr.io/virtualben89/opennit:1

APP_URL=http://localhost:8080
HTTP_PORT=8080

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=bitte-aendern-min10

DB_HOST=db
DB_PORT=3306
DB_NAME=opennit
DB_USER=opennit_user
DB_PASSWORD=bitte-aendern
DB_ROOT_PASSWORD=bitte-aendern-root
