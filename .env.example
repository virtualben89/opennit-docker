# Copy to .env and adjust / Nach .env kopieren und anpassen:  cp .env.example .env

# Image from the GitHub Container Registry / Image aus der GitHub Container Registry:
#   :1      follows all 1.x versions / folgt allen 1.x-Versionen
#   :1.2    bug fixes of 1.2 only / nur Bugfixes von 1.2
#   :1.2.2  pinned, update only by changing this value / fest, Update nur durch Ändern dieses Werts
OPENNIT_IMAGE=ghcr.io/virtualben89/opennit:1

APP_URL=http://localhost:8080
HTTP_PORT=8080

# Only needed for the initial setup / Nur für die Ersteinrichtung nötig (min. 10 characters)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min10

DB_HOST=db
DB_PORT=3306
DB_NAME=opennit
DB_USER=opennit_user
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-root
